# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Database — defaults to SQLite when not set
# For PostgreSQL (used in docker-compose):
DATABASE_URL=postgresql://smiley:smiley@172.17.0.1:5432/smileydb

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://smileyfinder.fixtureapps.com

# Base URL embedded inside generated QR codes
SITE_BASE_URL=https://smileyfinder.fixtureapps.com

# OTP code validity in minutes
OTP_EXPIRY_MINUTES=10
